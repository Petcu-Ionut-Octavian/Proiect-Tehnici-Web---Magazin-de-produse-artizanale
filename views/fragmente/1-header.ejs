<div class="form-check form-switch">
    <input class="form-check-input" type="checkbox" id="schimba_tema">
    <label class="form-check-label" for="schimba_tema">
        <i id="icon-tema" class="fa-solid fa-moon"></i>
    </label>
</div>

<div class="col-md-12">
    <label class="form-label d-block">Alege tema</label>

    <div class="btn-group" role="group">

        <!-- Light -->
        <input type="radio" class="btn-check" name="gr_tema" id="tema-light" value="light" checked>
        <label class="btn btn-outline-secondary" for="tema-light">
            <i class="bi bi-brightness-high"></i>
        </label>

        <!-- Dark -->
        <input type="radio" class="btn-check" name="gr_tema" id="tema-dark" value="dark">
        <label class="btn btn-outline-dark" for="tema-dark">
            <i class="bi bi-moon-stars"></i>
        </label>

        <!-- Tema 1 -->
        <input type="radio" class="btn-check" name="gr_tema" id="tema-tema1" value="tema1">
        <label class="btn btn-outline-primary" for="tema-tema1">
            <i class="bi bi-palette"></i>
        </label>

        <!-- Tema 2 -->
        <input type="radio" class="btn-check" name="gr_tema" id="tema-tema2" value="tema2">
        <label class="btn btn-outline-primary" for="tema-tema2">
            <i class="bi bi-palette-fill"></i>
        </label>

        <!-- Tema 3 -->
        <input type="radio" class="btn-check" name="gr_tema" id="tema-tema3" value="tema3">
        <label class="btn btn-outline-primary" for="tema-tema3">
            <i class="bi bi-droplet-half"></i>
        </label>

    </div>
</div>

<script src="/resurse/js/tema.js"></script>