<section id="galerie-statica">
    <h2>Galerie</h2>
    <p class="subtitlu">O selecție de creații artizanale realizate manual</p>

    <div id="grid-galerie">

    

        <% 
        const roman = [
            "I","II","III","IV","V","VI","VII","VIII","IX","X",
            "XI","XII","XIII","XIV","XV","XVI","XVII","XVIII","XIX","XX",
            "XXI","XXII","XXIII","XXIV","XXV","XXVI","XXVII","XXVIII","XXIX","XXX"
            ];

        let idx = 0;
        %>

        <%
        let p = idx % 4;
        let col;

        if (p === 0) col = 1;      
        else if (p === 1) col = 2; 
        else if (p === 2) col = 3; 
        else if (p === 3) col = 2; 
        %>

        <% for (let imag of imagini) { 

            // PNG original (desktop)
            const fisier_png = imag.fisier;   // deja setat în initImagini()

            // WEBP pentru telefon/tabletă (generat de initImagini)
            const fisier_webp = imag.fisier_mediu;

            const altText = imag.continut_alternativ || imag.nume_poza;
        %>

        <%
        let p = idx % 4;
        let col;

        if (p === 0) col = 1;      // x o o
        else if (p === 1) col = 2; // o x o
        else if (p === 2) col = 3; // o o x
        else if (p === 3) col = 2; // o x o

        // tabletă (2 coloane)
        let colTablet;
        if (p === 0) colTablet = 1;
        else if (p === 1) colTablet = 2;
        else if (p === 2) colTablet = 1;
        else if (p === 3) colTablet = 2;
        

        %>

        <figure style="--col-desktop:<%= col %>; --col-tablet:<%= colTablet %>; --row:<%= idx+1 %>;">
            <picture>
                <source srcset="<%= fisier_webp %>" media="(max-width:600px)" type="image/webp">
                <source srcset="<%= fisier_webp %>" media="(max-width:1100px)" type="image/webp">
                <img 
                    src="<%= fisier_png %>" 
                    alt="<%= altText %>" 
                    title="<%= imag.descriere %>"
                    loading="lazy">
            </picture>

            <figcaption>
                <h6><%= roman[idx] || (idx+1) %>. <%= imag.nume_poza %></h6>
                <p><%= imag.descriere %></p>
            </figcaption>
        </figure>


        <% idx++; } %>

    </div>
    <hr>
</section>