<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Artizania - Produse</title>
    <meta name="description" content="Magazin de produse artizanale handmade: decorațiuni, accesorii, cadouri personalizate și creații unicat realizate de artizani locali.">
    <meta name="keywords" content="Artizania, handmade, produse handmade, artizani locali, obiecte realizate manual, decorațiuni handmade, accesorii handmade, cosmetice naturale, cadouri personalizate, produse unicat, materiale pentru creație, fire și textile, materiale naturale, seturi DIY, accesorii meșteșug, ambalaje artizanale, lumânări parfumate, ceramică pictată manual, decorațiuni din lemn, accesorii textile brodate, comunitate artizani, creații autentice, produse artizanale România">

    <%- include('../fragmente/0-head.ejs') %>

    <link rel="stylesheet" href="/resurse/css/9-produse.css">

    <script type="text/javascript" src=/resurse/js/produse.js></script>
    <script type="text/javascript" src=/resurse/js/produse-cos.js></script>

</head>

    <body>

    <%- include("../fragmente/1-header") %>

    <main>



        <label> Nume:
            <input type="text" id="inp-nume">
        </label>

        <label> Preț minim:
            <input type="range" id="inp-pret" value="0" min="0" max="200">
            <span id="infoRange">(0)</span>
        </label>

        <label> Categorie:
            <select id="inp-categorie">
                <option value="toate" selected>Toate</option>

                <% for (let opt of optiuni) { %>
                    <option value="<%= opt.categorie %>"><%= opt.categorie %></option>
                <% } %>
            </select>
        </label>


        <label> Materiale:
            <select id="inp-materiale" multiple>
                <option value="toate" selected>Toate</option>
                <option value="lemn">Lemn</option>
                <option value="vopsea">Vopsea</option>
                <option value="lac">Lac</option>
                <option value="hartie">Hârtie</option>
                <option value="textil">Textil</option>
                <option value="lipici">Lipici</option>
                <option value="metal">Metal</option>
                <option value="plastic">Plastic</option>
                <option value="pigment">Pigment</option>
                <option value="snur">Șnur</option>
                <option value="ceara">Ceară</option>
                <option value="fitil">Fitil</option>
                <option value="rama">Ramă</option>
                <option value="umplutura">Umplutură</option>
                <option value="flori">Flori</option>
                <option value="rasina">Rășină</option>
                <option value="tus">Tuș</option>
            </select>
        </label>

        <label> Caută după dată:
            <input list="lista-date" id="inp-data-datalist">
            <%
                let setDate = new Set();
                for (let art of articole) {
                    setDate.add(art.data_adaugare.toLocaleDateString("sv-SE"));
                }
                let dateDistincte = [...setDate];
            %>

            <datalist id="lista-date">
                <% dateDistincte.forEach(d => { %>
                    <option value="<%= d %>">
                <% }) %>
            </datalist>
        </label>


        <!-- 🔵 CHECKBOX GROUP pentru greutate -->
        <div> Greutate:
            <label><input type="checkbox" class="chk-greutate" value="usor" checked> Ușor</label>
            <label><input type="checkbox" class="chk-greutate" value="mediu" checked> Mediu</label>
            <label><input type="checkbox" class="chk-greutate" value="greu" checked> Greu</label>
        </div>


        <!-- 🔵 TEXTAREA (MINIMAL ADD) -->
        <label> Cuvinte cheie în descriere:
            <textarea id="inp-keywords" rows="2" placeholder="ex: manual, pictat, natural"></textarea>
        </label>


        <div>
            <p><label> Ecologic
                <input type="radio" name="gr_ecologic" value="true">
            </label></p>

            <p><label> Non-ecologic
                <input type="radio" name="gr_ecologic" value="false">
            </label></p>

            <p><label> Toate
                <input type="radio" name="gr_ecologic" value="toate" checked>
            </label></p>
        </div>

        <p>
            <button id="filtrare">Filtrează</button>
            <button id="resetare">Resetează</button><br>

            <button id="sortCresc">Sortează crescător (preț → materiale)</button>
            <button id="sortDesc">Sortează descrescător (preț → materiale)</button>

            <button id="calculeaza">Calculează suma</button>
        </p>

        <p id="p-suma">Apăsați Alt+"c" pentru suma prețurilor produselor afișate.</p>




        <section id="produse">
            <h2>Produse artizanale</h2>

            <div class="grid-produse">
                <% let idx = 0; %>

                <% for (let art of articole) { %>
                    <article id="ent<%= art.id %>" 
                            class="produs <%= art.categorie %>"
                            data-index="<%= idx %>">

                        <% idx++; %>


                        <h3 class="nume">
                            <a href="/produs/<%= art.id %>">
                                <span class="val-nume"><%= art.nume %></span>
                            </a>
                        </h3>

                        <div class="container-produs">

                            <table class="tabel-caracteristici">
                                <tr>
                                    <th>Caracteristică</th>
                                    <th>Valoare</th>
                                </tr>

                                <tr>
                                    <td>Preț</td>
                                    <td class="val-pret"><%= art.pret %> lei</td>
                                </tr>

                                <tr>
                                    <td>Tip articol</td>
                                    <td class="val-tip"><%= art.tip_articol %></td>
                                </tr>

                                <tr>
                                    <td>Materiale</td>
                                    <td class="val-materiale"><%= art.materiale %></td>
                                </tr>

                                <tr>
                                    <td>Data adăugării</td>
                                    <td class="val-data">
                                        <time datetime="<%= art.data_adaugare.toLocaleDateString('sv-SE') %>">
                                            <% 
                                                const luni = ["Ianuarie","Februarie","Martie","Aprilie","Mai","Iunie","Iulie","August","Septembrie","Octombrie","Noiembrie","Decembrie"];
                                                const zile = ["Duminică","Luni","Marți","Miercuri","Joi","Vineri","Sâmbătă"];
                                                let d = art.data_adaugare;
                                            %>
                                            <%= d.getDate() %>(<%= zile[d.getDay()] %>)/<%= luni[d.getMonth()] %>/<%= d.getFullYear() %>
                                        </time>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Ecologic</td>
                                    <td class="val-ecologic"><%= art.este_ecologic ? "Da" : "Nu" %></td>
                                </tr>
                            </table>


                            <figure class="fig-produs">
                                <a href="/produs/<%= art.id %>">
                                    <img src="/resurse/imagini/produse/<%= art.imagine %>"
                                        alt="imagine <%= art.nume %>">
                                </a>
                            </figure>

                        </div>

                        <p class="descriere"><%= art.descriere %></p>

                        <p class="categorie-text">Categorie: <%= art.categorie %></p>

                        <!-- ascunse pentru filtrare/sortare -->
                        <span class="tip" style="display:none;"><%= art.tip_articol %></span>
                        <span class="categorie" style="display:none;"><%= art.categorie %></span>
                        <span class="ecologic" style="display:none;"><%= art.este_ecologic %></span>
                        <span class="materiale" style="display:none;"><%= art.materiale %></span>
                        <span class="greutate" style="display:none;"><%= art.greutate %></span>

                    </article>
                <% } %>
            </div>
        </section>

  

    </main>

    <%- include('../fragmente/2-footer.ejs') %>
    </body>
</html>