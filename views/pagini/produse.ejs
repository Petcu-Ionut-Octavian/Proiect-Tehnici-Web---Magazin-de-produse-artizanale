<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Artizania - Produse</title>
    <meta name="description" content="Magazin de produse artizanale handmade: decorațiuni, accesorii, cadouri personalizate și creații unicat realizate de artizani locali.">
    <meta name="keywords" content="Artizania, handmade, produse handmade, artizani locali, obiecte realizate manual, decorațiuni handmade, accesorii handmade, cosmetice naturale, cadouri personalizate, produse unicat, materiale pentru creație, fire și textile, materiale naturale, seturi DIY, accesorii meșteșug, ambalaje artizanale, lumânări parfumate, ceramică pictată manual, decorațiuni din lemn, accesorii textile brodate, comunitate artizani, creații autentice, produse artizanale România">

    <%- include('../fragmente/0-head.ejs') %>

    <link rel="stylesheet" href="/resurse/css/9-produse.css">

    <script type="text/javascript" src=/resurse/js/produse.js></script>
    <script type="text/javascript" src=/resurse/js/produse-cos.js></script>

</head>

    <body>

    <%- include("../fragmente/1-header") %>

    <main>


<div class="container my-4">
    <div class="row g-3">

        <!-- NUME -->
        <div class="col-md-4">
            <label for="inp-nume" class="form-label">Nume</label>
            <input type="text" id="inp-nume" class="form-control">
        </div>

        <!-- PREȚ MINIM -->
        <div class="col-md-4">
            <label for="inp-pret" class="form-label">
                Preț minim: <span id="infoRange">(0)</span>
            </label>
            <input type="range" id="inp-pret" class="form-range" min="0" max="200" value="0">
        </div>

        <!-- CATEGORIE -->
        <div class="col-md-4">
            <label for="inp-categorie" class="form-label">Categorie</label>
            <select id="inp-categorie" class="form-select">
                <option value="toate" selected>Toate</option>
                <% for (let opt of optiuni) { %>
                    <option value="<%= opt.categorie %>"><%= opt.categorie %></option>
                <% } %>
            </select>
        </div>

        <!-- MATERIALE -->
        <div class="col-md-6">
            <label for="inp-materiale" class="form-label">Materiale</label>
            <select id="inp-materiale" class="form-select" multiple>
                <option value="toate" selected>Toate</option>
                <option value="lemn">Lemn</option>
                <option value="vopsea">Vopsea</option>
                <option value="lac">Lac</option>
                <option value="hartie">Hârtie</option>
                <option value="textil">Textil</option>
                <option value="lipici">Lipici</option>
                <option value="metal">Metal</option>
                <option value="plastic">Plastic</option>
                <option value="pigment">Pigment</option>
                <option value="snur">Șnur</option>
                <option value="ceara">Ceară</option>
                <option value="fitil">Fitil</option>
                <option value="rama">Ramă</option>
                <option value="umplutura">Umplutură</option>
                <option value="flori">Flori</option>
                <option value="rasina">Rășină</option>
                <option value="tus">Tuș</option>
            </select>
        </div>

        <!-- DATĂ (DATALIST) -->
        <div class="col-md-6">
            <label for="inp-data-datalist" class="form-label">Caută după dată</label>
            <input list="lista-date" id="inp-data-datalist" class="form-control">

            <%
                let setDate = new Set();
                for (let art of articole) {
                    setDate.add(art.data_adaugare.toLocaleDateString("sv-SE"));
                }
                let dateDistincte = [...setDate];
            %>


            <datalist id="lista-date">
                <% dateDistincte.forEach(d => { %>
                    <option value="<%= d %>">
                <% }) %>
            </datalist>
        </div>

        <!-- GREUTATE (TOGGLE BUTTONS) -->
        <div class="col-md-12">
            <label class="form-label d-block">Greutate</label>

            <div class="btn-group" role="group">
                <input type="checkbox" class="btn-check chk-greutate" id="g-usor" value="usor" checked>
                <label class="btn btn-outline-primary" for="g-usor">Ușor</label>

                <input type="checkbox" class="btn-check chk-greutate" id="g-mediu" value="mediu" checked>
                <label class="btn btn-outline-primary" for="g-mediu">Mediu</label>

                <input type="checkbox" class="btn-check chk-greutate" id="g-greu" value="greu" checked>
                <label class="btn btn-outline-primary" for="g-greu">Greu</label>
            </div>
        </div>

        <!-- TEXTAREA (FLOATING LABEL) -->
        <div class="col-md-12 form-floating">
            <textarea class="form-control" id="inp-keywords" placeholder="ex: manual, pictat"></textarea>
            <label for="inp-keywords">Cuvinte cheie în descriere</label>
        </div>

        <!-- ECOLOGIC (TOGGLE RADIO BUTTONS) -->
        <div class="col-md-12">
            <label class="form-label d-block">Ecologic</label>

            <div class="btn-group" role="group">
                <input type="radio" class="btn-check" name="gr_ecologic" id="eco-da" value="true">
                <label class="btn btn-outline-success" for="eco-da">Ecologic</label>

                <input type="radio" class="btn-check" name="gr_ecologic" id="eco-nu" value="false">
                <label class="btn btn-outline-danger" for="eco-nu">Non-ecologic</label>

                <input type="radio" class="btn-check" name="gr_ecologic" id="eco-toate" value="toate" checked>
                <label class="btn btn-outline-secondary" for="eco-toate">Toate</label>
            </div>
        </div>

        <!-- BUTOANE -->
        <div class="col-md-12 d-flex flex-wrap gap-2 mt-3">

            <button id="filtrare" class="btn btn-primary btn-lg">
                <i class="bi bi-funnel"></i>
                <span class="d-none d-sm-inline">Filtrează</span>
            </button>

            <button id="resetare" class="btn btn-secondary btn-lg">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span class="d-none d-sm-inline">Resetează</span>
            </button>

            <button id="sortCresc" class="btn btn-info btn-lg">
                <i class="bi bi-sort-up"></i>
                <span class="d-none d-sm-inline">Sortare crescătoare</span>
            </button>

            <button id="sortDesc" class="btn btn-info btn-lg">
                <i class="bi bi-sort-down"></i>
                <span class="d-none d-sm-inline">Sortare descrescătoare</span>
            </button>

            <button id="calculeaza" class="btn btn-warning btn-lg">
                <i class="bi bi-calculator"></i>
                <span class="d-none d-sm-inline">Calculează suma</span>
            </button>

        </div>

        <!-- PARAGRAF ALT + C -->
        <div class="col-md-12">
            <p id="p-suma" class="mt-2">
                Apăsați Alt + "c" pentru suma prețurilor produselor afișate.
            </p>
        </div>

    </div>
</div>





        <section id="produse">
            <h2>Produse artizanale</h2>

            <div class="grid-produse">
                <% let idx = 0; %>

                <% for (let art of articole) { %>
                    <article id="ent<%= art.id %>" 
                            class="produs <%= art.categorie %>"
                            data-index="<%= idx %>">

                        <% idx++; %>


                        <h3 class="nume">
                            <a href="/produs/<%= art.id %>">
                                <span class="val-nume"><%= art.nume %></span>
                            </a>
                        </h3>

                        <div class="container-produs">

                            <table class="tabel-caracteristici">
                                <tr>
                                    <th>Caracteristică</th>
                                    <th>Valoare</th>
                                </tr>

                                <tr>
                                    <td>Preț</td>
                                    <td class="val-pret"><%= art.pret %> lei</td>
                                </tr>

                                <tr>
                                    <td>Tip articol</td>
                                    <td class="val-tip"><%= art.tip_articol %></td>
                                </tr>

                                <tr>
                                    <td>Materiale</td>
                                    <td class="val-materiale"><%= art.materiale %></td>
                                </tr>

                                <tr>
                                    <td>Data adăugării</td>
                                    <td class="val-data">
                                        <time datetime="<%= art.data_adaugare.toLocaleDateString('sv-SE') %>">
                                            <% 
                                                const luni = ["Ianuarie","Februarie","Martie","Aprilie","Mai","Iunie","Iulie","August","Septembrie","Octombrie","Noiembrie","Decembrie"];
                                                const zile = ["Duminică","Luni","Marți","Miercuri","Joi","Vineri","Sâmbătă"];
                                                let d = art.data_adaugare;
                                            %>
                                            <%= d.getDate() %>(<%= zile[d.getDay()] %>)/<%= luni[d.getMonth()] %>/<%= d.getFullYear() %>
                                        </time>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Ecologic</td>
                                    <td class="val-ecologic"><%= art.este_ecologic ? "Da" : "Nu" %></td>
                                </tr>
                            </table>


                            <figure class="fig-produs">
                                <a href="/produs/<%= art.id %>">
                                    <img src="/resurse/imagini/produse/<%= art.imagine %>"
                                        alt="imagine <%= art.nume %>">
                                </a>
                            </figure>

                        </div>

                        <p class="descriere"><%= art.descriere %></p>

                        <p class="categorie-text">Categorie: <%= art.categorie %></p>

                        <!-- ascunse pentru filtrare/sortare -->
                        <span class="tip" style="display:none;"><%= art.tip_articol %></span>
                        <span class="categorie" style="display:none;"><%= art.categorie %></span>
                        <span class="ecologic" style="display:none;"><%= art.este_ecologic %></span>
                        <span class="materiale" style="display:none;"><%= art.materiale %></span>
                        <span class="greutate" style="display:none;"><%= art.greutate %></span>

                    </article>
                <% } %>
            </div>
        </section>

  

    </main>

    <%- include('../fragmente/2-footer.ejs') %>
    </body>
</html>