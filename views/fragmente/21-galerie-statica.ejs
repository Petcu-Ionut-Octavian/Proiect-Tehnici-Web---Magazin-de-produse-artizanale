<section id="galerie-statica">
    <h2>Galerie</h2>
    <p class="subtitlu">O selecție de creații artizanale realizate manual</p>

    <div id="grid-galerie">

        <% for(let imag of locals.imagini) { %>
            <figure>
                <picture>
                    <source srcset="<%- imag.fisier_mediu %>" media="(max-width:1100px)">
                    <img src="<%- imag.fisier%>" alt="briose">
                </picture>
                <figcaption><%- imag.descriere %></figcaption>
            </figure>
        <% } %>


        <figure>
            <div>
                <img src="/resurse/imagini/ceramica-pictata.webp" alt="ceramică pictată" loading="lazy">
            </div>
            <figcaption>Ceramică pictată manual</figcaption>
        </figure>

        <figure>
            <img src="/resurse/imagini/lumanare-parfumata.webp" alt="lumânare artizanală" loading="lazy">
            <figcaption>Lumânare parfumată artizanală</figcaption>
        </figure>

        <figure>
            <img src="/resurse/imagini/bratara-impletita.webp" alt="brățară împletită" loading="lazy">
            <figcaption>Brățară împletită manual</figcaption>
        </figure>

        <figure>
            <img src="/resurse/imagini/agenda-handmade.webp" alt="agendă handmade" loading="lazy">
            <figcaption>Agendă legată manual</figcaption>
        </figure>

        <figure>
            <img src="/resurse/imagini/ornament-lemn.webp" alt="ornament din lemn" loading="lazy">
            <figcaption>Ornament sculptat în lemn</figcaption>
        </figure>

        <figure>
            <img src="/resurse/imagini/cercei-argila.webp" alt="cercei din argilă" loading="lazy">
            <figcaption>Cercei din argilă polimerică</figcaption>
        </figure>

        <figure>
            <img src="/resurse/imagini/tesatura-artizanala.webp" alt="țesătură artizanală" loading="lazy">
            <figcaption>Țesătură artizanală</figcaption>
        </figure>

    </div>
    <hr>
</section>